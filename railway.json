{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --include=dev && npm run build:private"
  },
  "deploy": {
    "startCommand": "node --require ./scripts/synthetic-egress-deny.cjs ./apps/api/dist/syntheticRuntimeHandoff.js",
    "healthcheckPath": null,
    "healthcheckTimeout": null,
    "restartPolicyType": "NEVER",
    "restartPolicyMaxRetries": null
  }
}
