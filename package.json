{
  "name": "vts-terminal",
  "version": "0.2.0",
  "private": true,
  "description": "Vitalis Trading Systems Terminal — monorepo (frontend + backend).",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "setup": "npm install && npm --workspace @vts/api run setup",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @vts/api run dev",
    "dev:web": "npm --workspace @vts/web run dev",
    "build": "npm run build:private && npm run build:marketing && npm run build:public",
    "start": "npm --workspace @vts/api run start",
    "typecheck": "npm --workspace @vts/api run typecheck && npm --workspace @vts/web run typecheck",
    "verify": "node scripts/verify.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "db:migrate": "npm --workspace @vts/api run db:migrate",
    "db:seed": "npm --workspace @vts/api run db:seed",
    "db:verify-positions": "npm --workspace @vts/api run db:verify-positions --",
    "db:check-sharing": "npm --workspace @vts/api run db:check-sharing",
    "db:check-alerts": "npm --workspace @vts/api run db:check-alerts",
    "db:check-package-add": "npm --workspace @vts/api run db:check-package-add",
    "db:check-capital": "npm --workspace @vts/api run db:check-capital",
    "db:check-notes": "npm --workspace @vts/api run db:check-notes",
    "db:check-rollover": "npm --workspace @vts/api run db:check-rollover",
    "db:check-founder-trades": "npm --workspace @vts/api run db:check-founder-trades",
    "db:check-ai-usage": "npm --workspace @vts/api run db:check-ai-usage",
    "db:check-password-reset": "npm --workspace @vts/api run db:check-password-reset",
    "verify:market-macro": "npm --workspace @vts/api run verify:market-macro",
    "verify:rollover": "npm --workspace @vts/api run verify:rollover",
    "verify:investments": "npm --workspace @vts/api run verify:investments",
    "verify:migrations": "npm --workspace @vts/api run verify:migrations",
    "verify:secretbox": "npm --workspace @vts/api run verify:secretbox",
    "verify:study-packages": "npm --workspace @vts/api run verify:study-packages",
    "verify:study-categories": "npm --workspace @vts/web run verify:study-categories",
    "verify:sizing": "npm --workspace @vts/web run verify:sizing",
    "verify:desk-layout": "npm --workspace @vts/web run verify:desk-layout",
    "build:private": "npm --workspace @vts/api run build && npm --workspace @vts/web run build",
    "build:marketing": "node scripts/build-static-app.mjs apps/marketing",
    "build:public": "node scripts/build-static-app.mjs apps/public-terminal",
    "start:private": "npm --workspace @vts/api run start",
    "verify:boundaries": "node scripts/verify-public-boundary.mjs && node scripts/verify-private-access.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
