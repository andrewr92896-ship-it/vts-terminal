{
  "name": "vts-terminal",
  "version": "0.2.0",
  "private": true,
  "description": "Vitalis Trading Systems Terminal \u2014 monorepo (frontend + backend).",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/public-api"
  ],
  "scripts": {
    "setup": "npm install && npm --workspace @vts/api run setup",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @vts/api run dev",
    "dev:web": "npm --workspace @vts/web run dev",
    "build": "npm run build:private && npm run build:marketing && npm run build:public && npm run build:public-api",
    "start": "npm --workspace @vts/api run start",
    "typecheck": "npm --workspace @vts/api run typecheck && npm --workspace @vts/web run typecheck && npm --workspace @vts/public-api run typecheck",
    "preflight": "npm --workspace @vts/api run preflight",
    "verify": "node scripts/verify.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "db:migrate": "npm --workspace @vts/api run db:migrate",
    "db:inspect": "npm --workspace @vts/api run db:inspect",
    "db:seed": "npm --workspace @vts/api run db:seed",
    "db:verify-positions": "npm --workspace @vts/api run db:verify-positions --",
    "db:check-sharing": "npm --workspace @vts/api run db:check-sharing",
    "db:check-alerts": "npm --workspace @vts/api run db:check-alerts",
    "db:check-package-add": "npm --workspace @vts/api run db:check-package-add",
    "db:check-capital": "npm --workspace @vts/api run db:check-capital",
    "db:check-notes": "npm --workspace @vts/api run db:check-notes",
    "db:check-rollover": "npm --workspace @vts/api run db:check-rollover",
    "db:check-founder-trades": "npm --workspace @vts/api run db:check-founder-trades",
    "db:check-ai-usage": "npm --workspace @vts/api run db:check-ai-usage",
    "db:check-password-reset": "npm --workspace @vts/api run db:check-password-reset",
    "verify:market-macro": "npm --workspace @vts/api run verify:market-macro",
    "verify:rollover": "npm --workspace @vts/api run verify:rollover",
    "verify:investments-mirror": "npx tsx scripts/verify-investments-mirror.mjs",
    "verify:investments": "npm --workspace @vts/api run verify:investments",
    "verify:migrations": "npm --workspace @vts/api run verify:migrations",
    "verify:config": "npm --workspace @vts/api run verify:config",
    "verify:private-access": "npm --workspace @vts/api run verify:private-access",
    "verify:secretbox": "npm --workspace @vts/api run verify:secretbox",
    "verify:ai-provider": "npm --workspace @vts/api run verify:ai-provider",
    "verify:study-packages": "npm --workspace @vts/api run verify:study-packages",
    "verify:study-categories": "npm --workspace @vts/web run verify:study-categories",
    "verify:movement": "npm --workspace @vts/web run verify:movement",
    "verify:sizing": "npm --workspace @vts/web run verify:sizing",
    "verify:protection": "npm --workspace @vts/web run verify:protection",
    "verify:desk-layout": "npm --workspace @vts/web run verify:desk-layout",
    "build:private": "npm --workspace @vts/api run build && npm --workspace @vts/web run build",
    "build:marketing": "node scripts/build-static-app.mjs apps/marketing",
    "build:public": "npm --workspace @vts/web run build:public",
    "build:public-api": "npm --workspace @vts/public-api run build",
    "start:private": "npm --workspace @vts/api run start",
    "verify:boundaries": "node scripts/verify-public-imports.mjs && node scripts/verify-public-boundary.mjs && node scripts/verify-public-api-boundary.mjs && node scripts/verify-private-access.mjs",
    "verify:public-imports": "node scripts/verify-public-imports.mjs",
    "verify:public-api": "npm --workspace @vts/public-api test && npm --workspace @vts/public-api run verify:migrations",
    "db:check-two-factor": "npm --workspace @vts/api run db:check-two-factor",
    "verify:demo-writes": "npm --workspace @vts/web run verify:demo-writes",
    "verify:demo-coverage": "node scripts/verify-demo-coverage.mjs",
    "verify:limits-mirror": "node scripts/verify-limits-mirror.mjs",
    "verify:legal-hashes": "node scripts/verify-legal-hashes.mjs",
    "verify:postgres": "npm --workspace @vts/public-api run test:postgres",
    "db:migrate:public": "npm --workspace @vts/public-api run db:migrate",
    "verify:public-wiring": "node scripts/verify-public-wiring.mjs",
    "verify:marketing-render": "node scripts/verify-marketing-render.mjs",
    "verify:marketing-server": "node scripts/verify-marketing-server.mjs",
    "db:check-site-editor": "npm --workspace @vts/api run db:check-site-editor",
    "verify:maintenance": "npm --workspace @vts/api run verify:maintenance && npm --workspace @vts/web run verify:maintenance",
    "verify:pushover": "npm --workspace @vts/api run verify:pushover",
    "verify:my-terminal": "npm --workspace @vts/web run verify:my-terminal"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
