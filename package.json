{
  "name": "vts-portal",
  "version": "0.2.0",
  "private": true,
  "description": "Vitalis Trading Systems Portal \u2014 monorepo (frontend + backend).",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "setup": "npm install && npm --workspace @vts/api run setup",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @vts/api run dev",
    "dev:web": "npm --workspace @vts/web run dev",
    "build": "npm --workspace @vts/api run build && npm --workspace @vts/web run build",
    "start": "npm --workspace @vts/api run start",
    "typecheck": "npm --workspace @vts/api run typecheck && npm --workspace @vts/web run typecheck",
    "db:migrate": "npm --workspace @vts/api run db:migrate",
    "db:seed": "npm --workspace @vts/api run db:seed",
    "db:verify-positions": "npm --workspace @vts/api run db:verify-positions --",
    "db:check-sharing": "npm --workspace @vts/api run db:check-sharing",
    "db:check-alerts": "npm --workspace @vts/api run db:check-alerts",
    "verify:market-macro": "npm --workspace @vts/api run verify:market-macro",
    "verify:investments": "npm --workspace @vts/api run verify:investments",
    "verify:migrations": "npm --workspace @vts/api run verify:migrations",
    "verify:secretbox": "npm --workspace @vts/api run verify:secretbox",
    "verify:study-packages": "npm --workspace @vts/api run verify:study-packages"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
