# Dependencies
node_modules/

# Build output
dist/
apps/web/dist/
apps/api/dist/

# Environment and secrets — NEVER commit these
.env
.env.*
!.env.example

# SQLite database files and backups
apps/api/data/*.db
apps/api/data/*.db-shm
apps/api/data/*.db-wal
apps/api/data/*.sqlite
*.db
*.sqlite

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Claude Code config. Personal/per-machine settings stay local, but the
# session-start guard and the settings that register it are SHARED on purpose:
# the portal is worked on from more than one machine, and a check that only
# exists on one of them is exactly how a session ended up editing a stale clone.
.claude/*
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json
.claude/launch.json

# Scratch databases written by npm run verify:db
.tmp-verify/
test-results/

# TypeScript incremental build info
*.tsbuildinfo
