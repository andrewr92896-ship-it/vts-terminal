# ============================================================
# Vitalis Trading Systems Portal — environment template
# Copy this file to apps/api/.env and fill in real values.
# NEVER commit the real .env file. Broker keys and secrets
# live ONLY in apps/api/.env (backend) or a password manager.
#
# PRODUCTION (Railway) — set these as service variables, NOT a file:
#   NODE_ENV=production
#   SESSION_SECRET=<48+ random bytes hex>
#   COOKIE_SECURE=true
#   DATABASE_URL=file:/data/vts.db        (path inside the mounted volume)
#   WEB_ORIGIN=https://vitalistradingsystems.com
#   ADMIN_USERNAME=andrew
#   ADMIN_PASSWORD=<your chosen strong password>
#   (PORT is provided by Railway automatically — do not set it.)
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000

# Origin allowed to call the API (the frontend dev server).
WEB_ORIGIN=http://localhost:5173

# --- Database (SQLite via libsql) ---
# Local file. Backups are a copy of this file.
DATABASE_URL=file:./data/vts.db

# --- Sessions ---
# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Session lifetime in days.
SESSION_TTL_DAYS=14
# Set true only when serving over HTTPS in production.
COOKIE_SECURE=false

# --- Initial admin (used once by the seed script) ---
# If ADMIN_PASSWORD is left blank, the seed generates a strong
# random password and prints it to the console one time.
ADMIN_USERNAME=andrew
ADMIN_DISPLAY_NAME=Andrew Vitalis
ADMIN_PASSWORD=
# Optional: the seed derives the admin's email from the username + this domain
# (e.g. andrew@vitalistradingsystems.com). ADMIN_EMAIL overrides it outright.
APP_EMAIL_DOMAIN=vitalistradingsystems.com
ADMIN_EMAIL=

# --- Broker connection encryption ---
# Key used to encrypt per-user broker API credentials at rest. Optional —
# falls back to a key derived from SESSION_SECRET. Set once and keep it stable
# (changing it makes already-stored credentials undecryptable).
#   Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_KEY=

# --- Broker API keys ---
# Optional bootstrap: if these are set, on first boot they are encrypted into a
# per-user connection labeled "Andrew's Trades" for the admin. After that,
# traders manage their own connections in-app and these can be removed.
# These never reach the browser. Only OANDA and Kraken have live connectors;
# FTP/prop and TradeStation trades are entered by hand (no API integration).
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# OANDA_ENV: 'practice' (default) or 'live' — selects the OANDA v20 host.
OANDA_ENV=practice
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Claude / Anthropic ---
# Backend-only key (never reaches the browser). Leave blank to disable AI
# features (they report "not configured" instead of failing).
ANTHROPIC_API_KEY=
# Site-wide default model (Ask Claude, product knowledge); trade screenshot
# analysis uses the analysis model (Opus 4.8, vision).
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_ANALYSIS=claude-opus-4-8
# Per-user AI guardrails. AI_MONTHLY_LIMIT caps Claude calls per user per
# Eastern-Time month; AI_RATE_PER_MIN smooths bursts. Keeps usage (and cost)
# in check across every AI feature.
AI_MONTHLY_LIMIT=1000
AI_RATE_PER_MIN=15

# --- TradingView webhook (feeds the Trading Alerts screen) ---
# Shared secret that inbound alerts must include (in the alert JSON as
# "secret", or as a ?secret= query param). TradingView sends no auth of its
# own, so the webhook rejects everything when this is blank. Inbound alerts are
# stored and shown on the Alerts screen — they do not auto-place trades.
# Point the alert's Webhook URL at:
#   https://vitalistradingsystems.com/api/webhooks/tradingview
TRADINGVIEW_WEBHOOK_SECRET=

# ---- Market News feeds (background pollers, production only) ----
# The Market News desk pulls from several best-effort feeds every ~5 minutes. All
# are optional and failures never affect the rest of the app.
#  • Curated RSS headlines — free, no key. General market news, the Federal
#    Reserve, Bitcoin/crypto, and USD/EUR (forex), from public RSS/Atom feeds.
#    On by default; set to false to turn the RSS poller off. Edit the feed list
#    in apps/api/src/trading/feeds.ts (RSS_FEEDS) to add or swap sources.
RSS_NEWS_ENABLED=true
#    Each new batch of RSS headlines gets a single Claude read that tags every
#    story with a bias (bullish/bearish/neutral), an impact level, and a one-line
#    note on how it could affect the desk's trading. Needs ANTHROPIC_API_KEY; on
#    by default, set to false to ingest headlines without the AI read.
NEWS_AI_SUMMARY_ENABLED=true
#  • Finnhub general-market headlines — optional extra, set a key to enable
#    (https://finnhub.io). Leave blank to rely on the free RSS feeds above.
FINNHUB_API_KEY=
#  • Forex Factory economic calendar — free weekly JSON feed, no key required.
#    Live as releases print (actual values) and shows upcoming events. On by
#    default; set to false to turn the calendar poller off.
FOREX_FACTORY_ENABLED=true
#  • Truth Social mirror of a single public account. On by default; set to false
#    to disable. TRUTH_ACCOUNT_ID overrides which account is mirrored.
TRUTH_ENABLED=true
TRUTH_ACCOUNT_ID=

# ---- Phone push notifications (Web Push / VAPID) ----
# Drives the "Phone alerts" toggle: trade open/close events and new alerts buzz
# subscribed devices. Generate one keypair (keep it stable) with:
#   npx web-push generate-vapid-keys
# Leave both blank to disable push (the rest of the app is unaffected).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services can reach about your traffic (mailto: or URL).
VAPID_SUBJECT=mailto:admin@vitalistradingsystems.com

# ---- Pushover (notifications with a custom sound) ----
# One application token, created at https://pushover.net/apps/build. Each trader
# connects their own Pushover "user key" in Account Settings. Leave blank to
# disable Pushover. Optional PUSHOVER_SOUND forces a sound by name (a built-in or
# a custom one uploaded to the Pushover account); leave blank to let each trader
# pick the sound in their Pushover app.
PUSHOVER_APP_TOKEN=
PUSHOVER_SOUND=

# ---- Background job cadences (production only, optional tuning) ----
# All in seconds. The desk-watch reconciles broker positions so trade
# open/close notifications fire with no client open; session-watch fires each
# trader's own Strategy Session notifications; backfill imports closed trades.
# Defaults are sensible — override only to tune polling frequency.
DESK_WATCH_SECONDS=10
SESSION_WATCH_SECONDS=30
BACKFILL_INTERVAL_SECONDS=300

# ---- Employee portal (/employee) ----
# The employee portal is a separate, hardened surface with its own sessions:
# signing in to the main portal grants nothing there and vice versa. Every knob
# below ships at its strict value — loosening one is a deliberate act.
#
# Session lifetime. An employee session has both an absolute cap and an idle
# timeout, far tighter than the 14-day main-portal session.
EMPLOYEE_SESSION_HOURS=8
EMPLOYEE_IDLE_MINUTES=30
# Require a TOTP second factor (true by default). An employee without one is
# walked through enrollment before they can reach anything. Set to false only if
# you have a specific reason — it removes the strongest control on this surface.
EMPLOYEE_REQUIRE_2FA=true
# Optional network fence. A comma-separated list of IPv4/IPv6 addresses or CIDR
# ranges (e.g. "203.0.113.0/24, 2001:db8::/32"). When set, every /employee page
# load and /api/employee call from outside the list is refused before any
# password is checked, so a stolen credential is worthless off-network. The check
# FAILS CLOSED — if you set this to a range that does not include you, you will
# lock yourself out of /employee (the main portal is unaffected). Leave blank for
# no network restriction.
EMPLOYEE_IP_ALLOWLIST=
