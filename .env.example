# ============================================================
# Vitalis Trading Systems Portal — environment template
# Copy this file to apps/api/.env and fill in real values.
# NEVER commit the real .env file. Broker keys and secrets
# live ONLY in apps/api/.env (backend) or a password manager.
#
# PRODUCTION (Railway) — set these as service variables, NOT a file:
#   NODE_ENV=production
#   SESSION_SECRET=<48+ random bytes hex>
#   CREDENTIALS_KEY=<32+ random bytes base64>   REQUIRED — the API will not
#                                              start without it. See below.
#   COOKIE_SECURE=true
#   DATABASE_URL=file:/data/vts.db        (path inside the mounted volume)
#   WEB_ORIGIN=https://vitalistradingsystems.com
#   ADMIN_USERNAME=andrew
#   ADMIN_PASSWORD=<your chosen strong password>
#   (PORT is provided by Railway automatically — do not set it.)
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000

# Origin allowed to call the API (the frontend dev server).
WEB_ORIGIN=http://localhost:5173

# --- Database (SQLite via libsql) ---
# Local file. Backups are a copy of this file.
DATABASE_URL=file:./data/vts.db

# --- Sessions ---
# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Session lifetime in days.
SESSION_TTL_DAYS=14
# Emailed recovery credentials expire after this many minutes. Strict bounds:
# 5–30; default 15. They are stored only as Argon2 hashes and used once to enter
# the forced Change Password screen.
PASSWORD_RESET_TTL_MINUTES=15
# Set true only when serving over HTTPS in production.
COOKIE_SECURE=false

# Takes the private portal off the air and serves a plain "under maintenance"
# notice in its place. ONLY the exact string `true` closes it, so a value left
# behind as `false` (or a `1` or `yes` from somebody guessing the format) cannot
# take the terminal down by accident. It also stops every background watch, so
# it is how you silence the trade, session and price-alert notifications without
# deleting a row or disconnecting a broker. It deletes nothing: turn it off and
# everything is exactly as it was. /api/health keeps answering, so enabling it
# cannot roll its own deploy back.
PRIVATE_MAINTENANCE=
# Where the notice's "Try the public demo" button points. Refused unless it is
# an http(s) URL; defaults to the public terminal's own demo.
PUBLIC_TERMINAL_URL=

# --- Initial admin (used once by the seed script) ---
# If ADMIN_PASSWORD is left blank, the seed generates a strong
# random password and prints it to the console one time.
ADMIN_USERNAME=andrew
ADMIN_DISPLAY_NAME=Andrew Vitalis
ADMIN_PASSWORD=
# Optional: the seed derives the admin's email from the username + this domain
# (e.g. andrew@vitalistradingsystems.com). ADMIN_EMAIL overrides it outright.
APP_EMAIL_DOMAIN=vitalistradingsystems.com
ADMIN_EMAIL=

# --- Broker connection encryption ---
# Key that encrypts every per-user broker API credential at rest.
#
# REQUIRED IN PRODUCTION: the API refuses to start without it, and refuses a
# value equal to SESSION_SECRET — one secret must not protect both sessions and
# every broker key on the desk. In development it may be left blank, in which
# case a key is derived from SESSION_SECRET and a warning is logged on every
# boot (never from the built-in dev secret, which is refused outright).
#
# It must be 32+ bytes of GENERATED randomness, base64 or hex. A passphrase is
# rejected at boot — this is not a password you choose, it is a key you generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Set it once and keep it stable. Changing it makes every stored credential
# unreadable, and each trader has to re-enter their broker key.
CREDENTIALS_KEY=

# --- Broker API keys ---
# Optional bootstrap: if these are set, on first boot they are encrypted into a
# per-user connection labeled "Andrew's Trades" for the admin. After that,
# traders manage their own connections in-app and these can be removed.
# These never reach the browser. Only OANDA and Kraken have live connectors;
# FTP/prop and TradeStation trades are entered by hand (no API integration).
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# OANDA_ENV: 'practice' (default) or 'live' — selects the OANDA v20 host.
OANDA_ENV=practice

# --- OANDA pricing account (Market Data board + price alerts) ---
# The account the SITE uses to read prices, as opposed to reading anyone's
# positions. It powers the Market Data board (every signed-in account) and the
# price-alert watch. Without it, forex/metals/index rows fall back to their
# sample figures and are marked as sample, and forex/metals/index price alerts
# cannot fire; crypto is keyless and unaffected.
#
# USE A PRACTICE ACCOUNT. OANDA's rates are account-independent, so a practice
# account with nothing in it prices the board exactly as well as a live one — and
# if this credential ever leaks it reaches no money, no positions and no orders.
#
# Pricing NEVER falls back to a customer's own broker connection. It used to
# borrow the first active OANDA connection on the install, which spent that
# trader's rate limit to serve everybody else, invisibly to them. If neither pair
# below is set, the board simply shows sample values.
#
# Falls back to the general OANDA_* account above when unset.
OANDA_PRICING_TOKEN=
OANDA_PRICING_ACCOUNT_ID=
# 'practice' (default) or 'live'.
OANDA_PRICING_ENV=practice
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Claude / Anthropic ---
# Backend-only key (never reaches the browser). Leave blank to disable AI
# features (they report "not configured" instead of failing).
# Which provider serves the terminal's AI. Defaults to anthropic, which is what
# it did before OpenAI was an option — set it to openai to switch, and back to
# switch back. A restart, not a redeploy.
AI_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-4.1-mini
OPENAI_MODEL_ANALYSIS=gpt-4.1-mini

ANTHROPIC_API_KEY=
# Site-wide default model (Ask Claude, product knowledge); trade screenshot
# analysis uses the analysis model below.
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
# Vision / screenshot parsing. Sonnet 5 rather than Opus: reading a trade off a
# broker screenshot is structured extraction, not hard reasoning, and Sonnet 5
# is the first Sonnet-tier model with high-resolution vision — same capability
# on a screenshot at $3/$15 per million tokens against Opus's $5/$25. Set this
# back to claude-opus-4-8 to revert; it takes effect on restart, no redeploy.
ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-5
# Per-user AI guardrails. AI_MONTHLY_LIMIT covers text (questions, study
# generation, market hours) per Eastern-Time month. Screenshot-to-trade calls
# are metered but do not have a monthly product quota. AI_RATE_PER_MIN smooths
# bursts across both text and vision.
AI_MONTHLY_LIMIT=1000
AI_RATE_PER_MIN=15

# --- TradingView webhook (feeds the Trading Alerts screen) ---
# Shared secret that inbound alerts must include (in the alert JSON as
# "secret", or as a ?secret= query param). TradingView sends no auth of its
# own, so the webhook rejects everything when this is blank. Inbound alerts are
# stored and shown on the Alerts screen — they do not auto-place trades.
# Point the alert's Webhook URL at:
#   https://vitalistradingsystems.com/api/webhooks/tradingview
TRADINGVIEW_WEBHOOK_SECRET=

# ---- Market News feeds (background pollers, production only) ----
# The Market News desk pulls from several best-effort feeds every ~5 minutes. All
# are optional and failures never affect the rest of the app.
#  • Curated RSS headlines — free, no key. General market news, the Federal
#    Reserve, Bitcoin/crypto, and USD/EUR (forex), from public RSS/Atom feeds.
#    On by default; set to false to turn the RSS poller off. Edit the feed list
#    in apps/api/src/trading/feeds.ts (RSS_FEEDS) to add or swap sources.
RSS_NEWS_ENABLED=true
#    Each new batch of RSS headlines gets a single Claude read that tags every
#    story with a bias (bullish/bearish/neutral), an impact level, and a one-line
#    note on how it could affect the desk's trading. Needs ANTHROPIC_API_KEY.
#    **OPT-IN: off unless this is exactly 'true'.** It is a batched call every
#    five minutes forever, running whether or not anybody is signed in and
#    costing the same with one user as with a thousand; headlines ingest and
#    display fine without it. With it off, the bias cue is hidden on both news
#    surfaces rather than shown half-filled.
NEWS_AI_SUMMARY_ENABLED=false
#    The plain-language explainer on an economic-calendar release. Separate
#    switch, and ON by default: explanations are keyed by release title and
#    reused across every recurrence, so the spend converges to nothing after the
#    first few polls. Set to false to turn it off.
CALENDAR_AI_EXPLAINER_ENABLED=true
#  • Finnhub general-market headlines — optional extra, set a key to enable
#    (https://finnhub.io). Leave blank to rely on the free RSS feeds above.
FINNHUB_API_KEY=
#  • Forex Factory economic calendar — free weekly JSON feed, no key required.
#    Live as releases print (actual values) and shows upcoming events. On by
#    default; set to false to turn the calendar poller off.
FOREX_FACTORY_ENABLED=true
#  • Truth Social mirror of a single public account. On by default; set to false
#    to disable. TRUTH_ACCOUNT_ID overrides which account is mirrored.
TRUTH_ENABLED=true
TRUTH_ACCOUNT_ID=

# ---- FRED (Market Data macro series) ----
# Powers the macro half of the Market Data board — policy rates, CPI, payrolls,
# the Treasury curve, the VIX, the Fed balance sheet — from the St. Louis Fed.
#
# OPTIONAL, and the board reads live without it. FRED's chart-download CSV is
# keyless, so leaving this blank costs reliability, not the feature. Setting it
# switches to the documented JSON API (free and instant, from
# fred.stlouisfed.org/docs/api/api_key.html). A key that is set but rejected
# falls back to the keyless read rather than blanking the board, and a series
# that cannot be read at all keeps its sample figure and the grey Sample dot.
#
# Setting it also turns on the real "Last -> next review" release dates on the
# board. Those come from FRED's series/release + release/dates endpoints, which
# have NO keyless equivalent, so it is the one feature a keyless install cannot
# have — without a key those dates stay the catalog's hand-entered ones.
FRED_API_KEY=

# ---- YouTube Data API (Market News live-stream wall) ----
# Powers the LIVE badges, stream titles and viewer counts on Market News, and
# resolves a channel @handle to its UC… id so it can be embedded. Get a key from
# the Google Cloud console (enable "YouTube Data API v3"). Leave blank to turn
# the poller off: every channel then reads offline, the screen marks live-state
# as sample rather than faking it, and channels that already carry an id still
# embed the keyless player.
YOUTUBE_API_KEY=
# Quota is the real constraint — the API's default budget is 10,000 units/day.
# Live detection goes the cheap route (uploads playlist + videos.list = 2 units
# per channel per check) rather than search.list (100 units), so the defaults
# below cost roughly 4,600 units/day. Raise YOUTUBE_WATCH_SECONDS or lower
# YOUTUBE_CHANNELS_PER_TICK if you follow a lot of channels; the watch stops for
# the day once YOUTUBE_DAILY_QUOTA units are spent rather than erroring.
YOUTUBE_WATCH_SECONDS=300
YOUTUBE_CHANNELS_PER_TICK=8
YOUTUBE_DAILY_QUOTA=9000
# Opt-in fallback for a channel whose live stream never shows up in its uploads
# feed. Costs 100 units per channel per check — leave false unless you need it.
YOUTUBE_USE_SEARCH=false

# ---- Phone push notifications (Web Push / VAPID) ----
# Drives the "Phone alerts" toggle: trade open/close events and new alerts buzz
# subscribed devices. Generate one keypair (keep it stable) with:
#   npx web-push generate-vapid-keys
# Leave both blank to disable push (the rest of the app is unaffected).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services can reach about your traffic (mailto: or URL).
VAPID_SUBJECT=mailto:admin@vitalistradingsystems.com

# ---- Pushover (notifications with a custom sound) ----
# One application token, created at https://pushover.net/apps/build. Each trader
# then connects their own Pushover "user key" on Advanced Trading > Alert
# Settings. Leave blank to disable Pushover: the panel says outright that it is
# not set up on the server, and web push (which needs no credential from anyone)
# keeps working, so a price alert still reaches somebody.
#
# Optional PUSHOVER_SOUND forces a sound by name (a built-in one, or a custom
# one uploaded to the Pushover account); leave blank to let each trader pick the
# sound in their Pushover app.
PUSHOVER_APP_TOKEN=
PUSHOVER_SOUND=
# Where Pushover POSTs when somebody acknowledges a REPEATING alert on their
# phone, so the terminal's own banner clears too. Falls back to WEB_ORIGIN, and
# is omitted entirely unless one of them is a public https:// address — sending
# Pushover a localhost URL would be worse than sending none. Without it, a
# repeating alert is still cancellable from the terminal's own Acknowledge
# button; what is lost is the phone doing it.
PUSHOVER_CALLBACK_ORIGIN=

# ---- Background job cadences (production only, optional tuning) ----
# All in seconds. The desk-watch reconciles broker positions so trade
# open/close notifications fire with no client open; session-watch fires each
# trader's own Strategy Session notifications; backfill imports closed trades.
# Defaults are sensible — override only to tune polling frequency.
DESK_WATCH_SECONDS=10
SESSION_WATCH_SECONDS=30
BACKFILL_INTERVAL_SECONDS=300

# ---- Outbound email ----
#
# Two transports, shared by Employee Portal sign-in codes and main-terminal
# password recovery. Resend is tried first when RESEND_API_KEY is set; SMTP is
# the fallback. With neither, an employee sign-in code is printed to the server
# log, but password recovery remains unavailable and never logs its credential.
#
# PREFER RESEND ON A PAAS. Most hosts block outbound SMTP: Railway blocks ports
# 25/465/587/2525 on everything below its Pro plan (tightened Aug 2025), and
# Heroku/Render have similar restrictions. A block does NOT look like an error
# from your mail provider — the provider is never reached — it looks like a ~10s
# connection timeout, which is why time-to-fail is the fastest way to tell a
# blocked port from a bad password. Resend posts over HTTPS on port 443, which
# cannot be blocked without breaking the app itself.
#
# Setup: sign up at resend.com, create an API key, add a sending domain (use a
# SUBDOMAIN such as send.vitalistradingsystems.com so its SPF/DKIM records stay
# clear of the Google Workspace records on the root domain), paste the 2-3 DNS
# records it gives you at your DNS host, and verify.
RESEND_API_KEY=
# The From header, used by whichever transport is active. With Resend this
# address must be on a domain verified in the Resend dashboard. Falls back to
# SMTP_FROM when unset, so an existing SMTP deployment keeps working.
MAIL_FROM=Vitalis Trading Systems <no-reply@send.vitalistradingsystems.com>

# ---- Outbound email, SMTP fallback ----
# Shared by Employee Portal sign-in codes and password recovery when Resend is
# unset. With SMTP_HOST unset, employee codes use the existing log fallback, but
# password recovery remains unavailable and never logs its credential. The log
# fallback is a safety net, not a mode to run in — until email is configured,
# every employee's first sign-in needs somebody to read the code from the logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for implicit TLS (port 465); false for STARTTLS (port 587). `false` on
# 587 is not a downgrade — the connection is still upgraded to TLS. Match this
# to the port; do not mix a 465 port with SMTP_SECURE=false or vice versa.
SMTP_SECURE=false
SMTP_FROM="Vitalis Trading Systems" <no-reply@vitalistradingsystems.com>
#
# SMTP_FROM must be an address the provider will let you send as. Most reject —
# or silently rewrite — a From on a domain or mailbox you have not proved you
# own, and from the portal's side that failure looks like a bug in the code
# rather than a mail-account problem. When in doubt set SMTP_FROM to the same
# address as SMTP_USER; it always works, and the cosmetics can wait.
#
# Google Workspace (what vitalistradingsystems.com uses):
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@vitalistradingsystems.com
#   SMTP_PASS=<16-character App Password, spaces stripped>
#   SMTP_FROM=Vitalis Trading Systems <you@vitalistradingsystems.com>
#
# Two Google-specific traps, both of which fail in confusing ways:
#
#   1. Your normal account password will NOT work. Google requires an App
#      Password (myaccount.google.com/apppasswords), which in turn requires
#      2-Step Verification on that account. Google shows it as four groups of
#      four ("abcd efgh ijkl mnop") — strip the spaces before storing it. A
#      wrong or space-padded value shows up in the log as
#      "535-5.7.8 Username and Password not accepted". If the App Passwords
#      page is missing entirely, either 2SV is off or a Workspace admin has
#      disabled app passwords for the org.
#   2. Sending as a no-reply@ address the authenticating account does not own
#      will be refused or rewritten. To genuinely send as no-reply@, either
#      create that mailbox and verify it under Gmail's "Send mail as", or set
#      up the Workspace SMTP relay service (Admin console -> Apps -> Google
#      Workspace -> Gmail -> Routing) with "Require SMTP Authentication",
#      which permits any From on the domain. Prefer the relay for anything
#      beyond a handful of employees — per-account SMTP has daily send caps.

# ---- Employee portal (/employee) ----
# The employee portal is a separate, hardened surface with its own sessions:
# signing in to the main portal grants nothing there and vice versa. Every knob
# below ships at its strict value — loosening one is a deliberate act.
#
# Session lifetime. An employee session has both an absolute cap and an idle
# timeout, far tighter than the 14-day main-portal session.
EMPLOYEE_SESSION_HOURS=8
EMPLOYEE_IDLE_MINUTES=30
# Require a second factor (true by default): a six-digit code emailed to the
# employee's company sign-in address. There is nothing to enroll — the code is
# sent the moment the password checks out. Set to false only if you have a
# specific reason; it removes the strongest control on this surface.
EMPLOYEE_REQUIRE_2FA=true
# How long an emailed sign-in code stays valid.
EMPLOYEE_OTP_TTL_MINUTES=10
# "Remember this device" — how long a browser that confirmed a code may skip the
# next one. The password is still required every time; this only changes how
# often the emailed code is asked for. Each employee can forget a device from the
# Security screen, and a portal admin can forget all of someone's at once.
EMPLOYEE_REMEMBER_DEVICE_DAYS=30
# Optional network fence. A comma-separated list of IPv4/IPv6 addresses or CIDR
# ranges (e.g. "203.0.113.0/24, 2001:db8::/32"). When set, every /employee page
# load and /api/employee call from outside the list is refused before any
# password is checked, so a stolen credential is worthless off-network. The check
# FAILS CLOSED — if you set this to a range that does not include you, you will
# lock yourself out of /employee (the main portal is unaffected). Leave blank for
# no network restriction.
EMPLOYEE_IP_ALLOWLIST=
# Main terminal email two-factor authentication
AUTH_REQUIRE_2FA=false
AUTH_2FA_CODE_TTL_MINUTES=10
AUTH_2FA_REMEMBER_DAYS=30

