{
  "name": "@vts/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "preflight": "tsx src/preflight.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:inspect": "tsx src/db/inspect.ts",
    "db:seed": "tsx src/seed.ts",
    "db:verify-positions": "tsx src/trading/verifyPositions.ts",
    "db:check-sharing": "tsx src/studies/checkSharing.ts",
    "db:check-alerts": "tsx src/notifications/checkAlerts.ts",
    "db:check-package-add": "tsx src/studies/checkPackageAdd.ts",
    "db:check-capital": "tsx src/trading/checkCapital.ts",
    "db:check-notes": "tsx src/trading/checkNotes.ts",
    "db:check-rollover": "tsx src/trading/checkRollover.ts",
    "db:check-founder-trades": "tsx src/trading/checkFounderTrades.ts",
    "db:check-ai-usage": "tsx src/ai/checkUsage.ts",
    "db:check-password-reset": "tsx src/auth/checkPasswordReset.ts",
    "verify:market-macro": "tsx src/trading/verifyMarketMacro.ts",
    "verify:rollover": "tsx src/trading/verifyRollover.ts",
    "verify:investments": "tsx src/investments/verifyInvestments.ts",
    "verify:migrations": "tsx src/db/verifyMigrations.ts",
    "verify:config": "tsx src/verifyConfigChecks.ts",
    "verify:private-access": "tsx src/auth/verifyPrivateAccess.ts",
    "verify:secretbox": "tsx src/security/verifySecretbox.ts",
    "verify:ai-provider": "tsx src/ai/verifyProvider.ts",
    "verify:study-packages": "tsx src/studies/verifyStudyPackages.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "db:check-two-factor": "tsx src/auth/checkTwoFactor.ts",
    "verify:maintenance": "tsx src/verifyMaintenance.ts",
    "verify:pushover": "tsx src/notifications/verifyPushover.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^8.0.4",
    "@libsql/client": "^0.14.0",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "nodemailer": "^9.0.3",
    "pino-pretty": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
