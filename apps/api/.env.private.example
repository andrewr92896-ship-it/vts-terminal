NODE_ENV=production
PORT=4000
PRIVATE_PORTAL_ORIGIN=https://portal.vitalistradingsystems.com
PRIVATE_DATABASE_URL=
PRIVATE_SESSION_SECRET=
PRIVATE_SESSION_COOKIE=__Host-vts_portal_session
PRIVATE_ACCESS_USER_IDS=
PRIVATE_BOOTSTRAP_ADMIN_ID=
COOKIE_SECURE=true
CREDENTIALS_KEY=
PASSWORD_RESET_TTL_MINUTES=15
# Preferred password-recovery transport (HTTPS/443). Never commit a real key.
RESEND_API_KEY=
MAIL_FROM=Vitalis Trading Systems <no-reply@send.vitalistradingsystems.com>
# SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS/SMTP_SECURE/SMTP_FROM remain the
# fallback when Railway permits outbound SMTP.
# Main terminal email two-factor authentication
AUTH_REQUIRE_2FA=false
AUTH_2FA_CODE_TTL_MINUTES=10
AUTH_2FA_REMEMBER_DAYS=30

