{
  "name": "@vts/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "build:public": "tsc --noEmit -p tsconfig.public.json && vite build --config vite.public.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.public.json",
    "verify:study-categories": "tsx src/workspaces/studies/verifyStudyCategories.ts",
    "verify:movement": "tsx src/workspaces/trading/verifyMovement.ts",
    "verify:sizing": "tsx src/workspaces/trading/verifySizing.ts",
    "verify:protection": "tsx src/workspaces/trading/verifyProtection.ts",
    "verify:maintenance": "tsx src/lib/verifyMaintenance.ts",
    "verify:my-terminal": "tsx src/theme/verifyMyTerminal.ts",
    "verify:desk-layout": "tsx src/workspaces/trading/verifyDeskPositionsLayout.ts",
    "verify:demo-writes": "tsx ../public-terminal/src/demo/verifyDemoWrites.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/ibm-plex-sans": "^5.1.1",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
